# Porta da API REST
PORT=3333

# Caminho do arquivo SQLite (relativo à pasta do servidor)
DATABASE_PATH=data/devtrack.db

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Insere dados de demonstração ao iniciar a API (true/false)
SEED_DEMO_DATA=false
